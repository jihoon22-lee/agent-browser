            "Escape",
            "Space",
            "Backspace",
            "ArrowUp",
            "ArrowDown"
          ],
          "type": "string"
        },
        "operationId": {
          "description": "operationId returned by browser_tabs action=attach",
          "type": "string"
        },
        "ref": {
          "description": "Element ref from the latest browser_snapshot, e.g. s3f0e12",
          "type": "string"
        }
      },
      "required": [
        "operationId",
        "key"
      ],
      "type": "object"
    },
    "name": "browser_press"
  },
  {
    "description": "Scroll the page or a scrollable element (ref).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "up",
            "down",
            "top",
            "bottom"
          ],
          "type": "string"
        },
        "operationId": {
          "description": "operationId returned by browser_tabs action=attach",
          "type": "string"
        },
        "ref": {
          "description": "Element ref from the latest browser_snapshot, e.g. s3f0e12",
          "type": "string"
        }
      },
      "required": [
        "operationId",
        "direction"
      ],
      "type": "object"
    },
    "name": "browser_scroll"
  },
  {
    "description": "Wait until any condition matches: text appears, text disappears, an element ref disappears, or the URL contains a string. Use snapshot frameRef for iframe text/URL conditions; otherwise uses refGone's frame or the top document. A frameRef stays bound to its document; take a fresh snapshot after navigation. Fails with TIMEOUT.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "description": "operationId returned by browser_tabs action=attach",
          "type": "string"
        },
        "refGone": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "textGone": {
          "type": "string"
        },
        "timeoutMs": {
          "default": 5000,
          "maximum": 30000,
          "minimum": 100,
          "type": "integer"
        },
        "urlIncludes": {
          "type": "string"
        },
        "frameRef": {
          "type": "string",
          "description": "Document-bound frameRef returned on a browser_snapshot frame."
        }
      },
      "required": [
        "operationId"
      ],
      "type": "object"
    },
    "name": "browser_wait"
  },
  {
    "description": "Extract text, selection, or a table by snapshot ref (first table by default). maxChars bounds output. offset is a character index for text/selection, a data-row index for tables; follow nextOffset.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "text",
            "selection",
            "table"
          ],
          "type": "string"
        },
        "maxChars": {
          "default": 8000,
          "maximum": 50000,
          "minimum": 200,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "operationId": {
          "description": "operationId returned by browser_tabs action=attach",
          "type": "string"
        },
        "ref": {
          "description": "Element ref from the latest browser_snapshot, e.g. s3f0e12",
          "type": "string"
        }
      },
      "required": [
        "operationId",
        "kind"
      ],
      "type": "object"
    },
    "name": "browser_extract"
  },
  {
    "description": "Capture the visible part of the operation tab as PNG. Only works while that tab is the active tab of its window; otherwise returns NEEDS_TAB_ACTIVATION.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "description": "operationId returned by browser_tabs action=attach",
          "type": "string"
        }
      },
      "required": [
        "operationId"
      ],
      "type": "object"
    },
    "name": "browser_screenshot"
  }
