[
  {
    "description": "List Chrome tabs, attach a tab to start an operation (returns operationId), open a new tab in the operation, switch between the operation's tabs, or release the operation. The operation tab stays fixed even if the user looks at another tab.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "list",
            "attach",
            "new",
            "switch",
            "release"
          ],
          "type": "string"
        },
        "operationId": {
          "description": "operationId returned by browser_tabs action=attach",
          "type": "string"
        },
        "tabId": {
          "description": "For attach (omit to use the user's current tab) and switch",
          "type": "integer"
        },
        "url": {
          "description": "For new: http(s) URL to open",
          "type": "string"
        },
        "requestId": {
          "type": "string",
          "description": "For attach: requestId supplied with the current panel request. Omit tabId to use its captured active tab; an explicit user target takes priority."
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "name": "browser_tabs"
  },
  {
    "description": "Read DOM text, elements and tables with refs. Take a fresh snapshot after attach before writing. Continue with offset (text), elementOffset or frameOffset from returned cursors.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "maxChars": {
          "default": 4000,
          "maximum": 20000,
          "minimum": 200,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "operationId": {
          "description": "operationId returned by browser_tabs action=attach",
          "type": "string"
        },
        "elementOffset": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "frameOffset": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "required": [
        "operationId"
      ],
      "type": "object"
    },
    "name": "browser_snapshot"
  },
  {
    "description": "Go to an http(s) URL, or go back, forward, or reload, in the operation tab. Waits for the page to load.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "default": "goto",
          "enum": [
            "goto",
            "back",
            "forward",
            "reload"
          ],
          "type": "string"
        },
        "operationId": {
          "description": "operationId returned by browser_tabs action=attach",
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "operationId"
      ],
      "type": "object"
    },
    "name": "browser_navigate"
  },
  {
    "description": "Click an element by ref. Returns whether the URL or page content changed.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "description": "operationId returned by browser_tabs action=attach",
          "type": "string"
        },
        "ref": {
          "description": "Element ref from the latest browser_snapshot, e.g. s3f0e12",
          "type": "string"
        }
      },
      "required": [
        "operationId",
        "ref"
      ],
      "type": "object"
    },
    "name": "browser_click"
  },
  {
    "description": "Replace the value of a text input or textarea by ref. Returns the value read back from the page.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "description": "operationId returned by browser_tabs action=attach",
          "type": "string"
        },
        "ref": {
          "description": "Element ref from the latest browser_snapshot, e.g. s3f0e12",
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "operationId",
        "ref",
        "text"
      ],
      "type": "object"
    },
    "name": "browser_fill"
  },
  {
    "description": "Choose an option in a select (by option value or visible label) or set a checkbox/radio checked state, by ref.",
