          "description": "operationId returned by browser_tabs action=attach",
          "type": "string"
        },
        "option": {
          "type": "string"
        },
        "ref": {
          "description": "Element ref from the latest browser_snapshot, e.g. s3f0e12",
          "type": "string"
        }
      },
      "required": [
        "operationId",
        "ref"
      ],
      "type": "object"
    },
    "name": "browser_select"
  },
  {
    "description": "Press a key on the focused element or on ref. Enter in a form field submits the form.",
    "inputSchema": {
      "additionalProperties": false,
