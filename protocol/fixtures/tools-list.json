[
  {
    "description": "list/windows read tabs. In a panel request attach/new and page tools may omit requestId and operationId; otherwise attach (no tabId = request's tab) or new (url) with the Browser context requestId, then reuse operationId. Results include a snapshot and openTabs. about:blank tabs cannot be closed.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "list",
            "windows",
            "attach",
            "new",
            "switch",
            "close",
            "release"
          ],
          "type": "string"
        },
        "operationId": {
          "type": "string"
        },
        "requestId": {
          "description": "From Browser context; first attach/new",
          "type": "string"
        },
        "tabId": {
          "type": "integer"
        },
        "url": {
          "description": "new: http(s) URL or about:blank",
          "type": "string"
        },
        "windowId": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "name": "browser_tabs"
  },
  {
    "description": "Read-only bookmarks: list a folder (folderId) or search. Needs the optional bookmarks permission.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "list",
            "search"
          ],
          "type": "string"
        },
        "folderId": {
          "type": "string"
        },
        "limit": {
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "minimum": 0,
          "type": "integer"
        },
        "query": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "browser_bookmarks"
  },
  {
    "description": "Read page text and refs (DOM-based). Navigation, press and page-changing clicks already include one. query keeps matching lines, rows and elements. Continue with offset/elementOffset/frameOffset.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "elementOffset": {
          "minimum": 0,
          "type": "integer"
        },
        "frameOffset": {
          "minimum": 0,
          "type": "integer"
        },
        "maxChars": {
          "maximum": 20000,
          "minimum": 200,
          "type": "integer"
        },
        "offset": {
          "minimum": 0,
          "type": "integer"
        },
        "operationId": {
          "type": "string"
        },
        "query": {
          "maxLength": 80,
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "browser_snapshot"
  },
  {
    "description": "goto a URL, or back/forward/reload. Waits for load and returns a snapshot.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "goto",
            "back",
            "forward",
            "reload"
          ],
          "type": "string"
        },
        "operationId": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "browser_navigate"
  },
  {
    "description": "Click a ref; double/right/hover/drag (toRef). For a known outcome, use waitFor text/textGone/urlIncludes in this tab (default all, 5s): waits then returns a snapshot, without replaying the click. newTab opens a link; cannot use waitFor.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "click",
            "double",
            "right",
            "hover",
            "drag"
          ],
          "type": "string"
        },
        "newTab": {
          "type": "boolean"
        },
        "operationId": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "toRef": {
          "type": "string"
        },
        "waitFor": {
          "additionalProperties": false,
          "properties": {
            "match": {
              "enum": [
                "all",
                "any"
              ],
              "type": "string"
            },
            "text": {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            "textGone": {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            "timeoutMs": {
              "maximum": 30000,
              "minimum": 100,
              "type": "integer"
            },
            "urlIncludes": {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "ref"
      ],
      "type": "object"
    },
    "name": "browser_click"
  },
  {
    "description": "Replace the text of an input, textarea or editable area.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "ref",
        "text"
      ],
      "type": "object"
    },
    "name": "browser_fill"
  },
  {
    "description": "Choose a select option by value or label, or set checked on a checkbox/radio.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "checked": {
          "type": "boolean"
        },
        "operationId": {
          "type": "string"
        },
        "option": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "type": "object"
    },
    "name": "browser_select"
  },
  {
    "description": "Press Enter/Tab/Escape/Space/Backspace/Delete/Home/End/PageUp/PageDown/arrows, or a modified letter/digit, on ref or focus; returns a snapshot. Optional waitFor works like click (default all, 5s).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 10,
          "type": "string"
        },
        "modifiers": {
          "items": {
            "enum": [
              "Control",
              "Shift",
              "Alt",
              "Meta"
            ]
          },
          "maxItems": 4,
          "type": "array"
        },
        "operationId": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "waitFor": {
          "additionalProperties": false,
          "properties": {
            "match": {
              "enum": [
                "all",
                "any"
              ],
              "type": "string"
            },
            "text": {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            "textGone": {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            "timeoutMs": {
              "maximum": 30000,
              "minimum": 100,
              "type": "integer"
            },
            "urlIncludes": {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "key"
      ],
      "type": "object"
    },
    "name": "browser_press"
  },
  {
    "description": "Scroll the page or a ref container.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "up",
            "down",
            "top",
            "bottom"
          ],
          "type": "string"
        },
        "operationId": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      },
      "required": [
        "direction"
      ],
      "type": "object"
    },
    "name": "browser_scroll"
  },
  {
    "description": "Wait for text/textGone/refGone/urlIncludes. Default any; match=all combines text and URL conditions (without refGone).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "frameRef": {
          "type": "string"
        },
        "match": {
          "enum": [
            "any",
            "all"
          ],
          "type": "string"
        },
        "operationId": {
          "type": "string"
        },
        "refGone": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "textGone": {
          "type": "string"
        },
        "timeoutMs": {
          "maximum": 30000,
          "minimum": 100,
          "type": "integer"
        },
        "urlIncludes": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "browser_wait"
  },
  {
    "description": "Extract text, selection or a table (ref, else the first table); continue with nextOffset.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "text",
            "selection",
            "table"
          ],
          "type": "string"
        },
        "maxChars": {
          "maximum": 50000,
          "minimum": 200,
          "type": "integer"
        },
        "offset": {
          "minimum": 0,
          "type": "integer"
        },
        "operationId": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "name": "browser_extract"
  },
  {
    "description": "PNG of the operation tab; that tab must be active.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "browser_screenshot"
  },
  {
    "description": "Put a file the user attached to this request into a file input (its ref, label or button). file: the attachment name.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "operationId": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      },
      "required": [
        "ref",
        "file"
      ],
      "type": "object"
    },
    "name": "browser_upload"
  }
]
