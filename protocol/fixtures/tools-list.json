[
  {
    "description": "requestId is per panel request, not per tab. First attach/new needs it; reuse operationId thereafter. Switch accepts listed HTTP(S) tabs. Close needs a snapshot; about:blank tabs cannot be closed. Close returns to the last visited surviving tab.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "list",
            "windows",
            "attach",
            "new",
            "switch",
            "close",
            "release"
          ],
          "type": "string"
        },
        "operationId": {
          "description": "From browser_tabs attach/new",
          "type": "string"
        },
        "requestId": {
          "description": "Current Browser context requestId for first attach/new, even before a tab exists.",
          "type": "string"
        },
        "tabId": {
          "description": "Attach target (omit for request default), or explicit switch target",
          "type": "integer"
        },
        "url": {
          "description": "For new: HTTP(S) URL or about:blank (default)",
          "type": "string"
        },
        "windowId": {
          "description": "Filter list or choose window for new; IDs from windows",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "name": "browser_tabs"
  },
  {
    "description": "Read bookmarks only: list root folders or folderId children, or search titles/URLs. Requires the user's optional bookmarks permission in settings. Does not visit URLs or modify bookmarks.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "default": "list",
          "enum": [
            "list",
            "search"
          ],
          "type": "string"
        },
        "folderId": {
          "type": "string"
        },
        "limit": {
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "minimum": 0,
          "type": "integer"
        },
        "query": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "browser_bookmarks"
  },
  {
    "description": "Read DOM text/elements/tables with refs. Snapshot after attach, navigation, switch or rerender before writing; identify by name/href, never old index. Continue via offset/elementOffset/frameOffset cursors.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "elementOffset": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "frameOffset": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "maxChars": {
          "default": 4000,
          "maximum": 20000,
          "minimum": 200,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "operationId": {
          "description": "From browser_tabs attach/new",
          "type": "string"
        }
      },
      "required": [
        "operationId"
      ],
      "type": "object"
    },
    "name": "browser_snapshot"
  },
  {
    "description": "Navigate the operation tab to HTTP(S), back, forward or reload and wait for completion. For delayed content, browser_wait then snapshot before clicking.",
