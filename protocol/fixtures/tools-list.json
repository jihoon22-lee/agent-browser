[
  {
    "description": "list/windows read tabs. In a panel request attach/new and page tools may omit requestId and operationId; otherwise attach (no tabId = request's tab) or new (url) with the Browser context requestId, then reuse operationId. Results include a snapshot and openTabs. about:blank tabs cannot be closed.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "list",
            "windows",
            "attach",
            "new",
            "switch",
            "close",
            "release"
          ],
          "type": "string"
        },
        "operationId": {
          "description": "From attach/new",
          "type": "string"
        },
        "requestId": {
          "description": "From Browser context; first attach/new",
          "type": "string"
        },
        "tabId": {
          "type": "integer"
        },
        "url": {
          "description": "new: http(s) URL or about:blank",
          "type": "string"
        },
        "windowId": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "name": "browser_tabs"
  },
  {
    "description": "Read-only bookmarks: list a folder (folderId) or search. Needs the optional bookmarks permission.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "list",
            "search"
          ],
          "type": "string"
        },
        "folderId": {
          "type": "string"
        },
        "limit": {
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "minimum": 0,
          "type": "integer"
        },
        "query": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "browser_bookmarks"
  },
  {
    "description": "Re-read page text and elements with refs (DOM-based); actions already return one. query keeps only matching lines, rows and elements. Continue with offset/elementOffset/frameOffset.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "elementOffset": {
          "minimum": 0,
          "type": "integer"
        },
        "frameOffset": {
          "minimum": 0,
          "type": "integer"
        },
        "maxChars": {
          "maximum": 20000,
          "minimum": 200,
          "type": "integer"
        },
        "offset": {
          "minimum": 0,
          "type": "integer"
        },
        "operationId": {
          "description": "From attach/new",
          "type": "string"
        },
        "query": {
          "maxLength": 80,
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "browser_snapshot"
  },
  {
    "description": "goto a URL, or back/forward/reload. Waits for load and returns a snapshot.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "goto",
            "back",
            "forward",
            "reload"
          ],
          "type": "string"
        },
        "operationId": {
          "description": "From attach/new",
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "browser_navigate"
  },
  {
    "description": "Click a ref; returns a snapshot if the page changed. newTab opens an http(s) link in a new operation tab.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "newTab": {
          "type": "boolean"
        },
        "operationId": {
          "description": "From attach/new",
          "type": "string"
        },
        "ref": {
          "description": "Snapshot ref",
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "type": "object"
    },
    "name": "browser_click"
  },
  {
    "description": "Replace the text of an input, textarea or editable area.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "description": "From attach/new",
          "type": "string"
        },
        "ref": {
          "description": "Snapshot ref",
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "ref",
        "text"
      ],
      "type": "object"
    },
    "name": "browser_fill"
  },
  {
    "description": "Choose a select option by value or label, or set checked on a checkbox/radio.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "checked": {
          "type": "boolean"
        },
        "operationId": {
          "description": "From attach/new",
          "type": "string"
        },
        "option": {
          "type": "string"
        },
        "ref": {
          "description": "Snapshot ref",
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "type": "object"
    },
    "name": "browser_select"
  },
  {
    "description": "Press a key on ref or the focused element (Enter in a field submits); returns a snapshot.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "enum": [
            "Enter",
            "Tab",
            "Escape",
            "Space",
            "Backspace",
            "ArrowUp",
            "ArrowDown"
          ],
          "type": "string"
        },
        "operationId": {
          "description": "From attach/new",
          "type": "string"
        },
        "ref": {
          "description": "Snapshot ref",
          "type": "string"
        }
      },
      "required": [
        "key"
      ],
      "type": "object"
    },
    "name": "browser_press"
  },
  {
    "description": "Scroll the page or a ref container.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "up",
            "down",
            "top",
            "bottom"
          ],
          "type": "string"
        },
        "operationId": {
          "description": "From attach/new",
          "type": "string"
        },
        "ref": {
          "description": "Snapshot ref",
          "type": "string"
        }
      },
      "required": [
        "direction"
      ],
      "type": "object"
    },
    "name": "browser_scroll"
  },
  {
    "description": "Wait until any of text, textGone, refGone or urlIncludes holds, or timeout.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "frameRef": {
          "type": "string"
        },
        "operationId": {
          "description": "From attach/new",
          "type": "string"
        },
        "refGone": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "textGone": {
          "type": "string"
        },
        "timeoutMs": {
          "maximum": 30000,
          "minimum": 100,
          "type": "integer"
        },
        "urlIncludes": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "browser_wait"
  },
  {
    "description": "Extract text, selection or a table (ref, else the first table); continue with nextOffset.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "text",
            "selection",
            "table"
          ],
          "type": "string"
        },
        "maxChars": {
          "maximum": 50000,
          "minimum": 200,
          "type": "integer"
        },
        "offset": {
          "minimum": 0,
          "type": "integer"
        },
        "operationId": {
          "description": "From attach/new",
          "type": "string"
        },
        "ref": {
          "description": "Snapshot ref",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "name": "browser_extract"
  },
  {
    "description": "PNG of the operation tab; that tab must be active.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "description": "From attach/new",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "browser_screenshot"
  }
]
