[
  {
    "description": "List tabs/windows, attach, new, switch, close or release. New needs no snapshot; omit operationId to start an operation. Omit url for about:blank. Close only operation-created tabs; switch back explicitly. Switch changes the operation target.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "list",
            "windows",
            "attach",
            "new",
            "switch",
            "close",
            "release"
          ],
          "type": "string"
        },
        "operationId": {
          "description": "From browser_tabs attach/new",
          "type": "string"
        },
        "requestId": {
          "description": "Current panel requestId for attach or standalone new",
          "type": "string"
        },
        "tabId": {
          "description": "Attach target (omit for request default), or switch target",
          "type": "integer"
        },
        "url": {
          "description": "For new: HTTP(S) URL or about:blank (default)",
          "type": "string"
        },
        "windowId": {
          "description": "Filter list or choose window for new; IDs from windows",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "name": "browser_tabs"
  },
  {
    "description": "Read bookmarks only: list root folders or folderId children, or search titles/URLs. Requires the user's optional bookmarks permission in settings. Does not visit URLs or modify bookmarks.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "default": "list",
          "enum": [
            "list",
            "search"
          ],
          "type": "string"
        },
        "folderId": {
          "type": "string"
        },
        "limit": {
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "minimum": 0,
          "type": "integer"
        },
        "query": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "browser_bookmarks"
  },
  {
